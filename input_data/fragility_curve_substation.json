{
    "description": "Substation Submerged",
    "rules": [
        {
            "condition": [
                "inundationDepth > 0"
            ],
            "expression": "scipy.stats.norm.cdf((math.log(inundationDepth) - 2.302585092994046)/(0.1))"
        }
    ],
    "returnType": {
        "type": "Limit State",
        "unit": "",
        "description": "water_in_substation"
    }
}